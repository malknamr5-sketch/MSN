<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<meta name="theme-color" content="#d4af37">
<link rel="manifest" href="admin-manifest.json">
<link rel="icon" href="icon-192.png">
<title>MSN Admin</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.57.4/dist/umd/supabase.min.js"></script>
<style>
:root{--bg:#070707;--card:#121212;--line:#2a2a2a;--g:#d4af37;--g2:#f3e5ab;color-scheme:dark}
*{box-sizing:border-box;margin:0;padding:0;font-family:Tahoma,Arial,sans-serif}
[hidden]{display:none!important}
body{background:var(--bg);color:#fff;padding:calc(14px + env(safe-area-inset-top,0px)) 12px 40px}
.c{max-width:600px;margin:0 auto 12px;background:var(--card);border:1px solid var(--g);border-radius:14px;padding:14px}
h2{color:var(--g);font-size:16px;margin-bottom:10px}
input,select,textarea{width:100%;padding:10px;margin-bottom:8px;background:#000;border:1px solid var(--line);color:#fff;border-radius:8px;font-size:14px}
input[type=checkbox]{width:auto;margin-left:6px}
label{display:block;font-size:12px;color:var(--g2);margin-bottom:3px}
.b{width:100%;padding:12px;border:0;border-radius:8px;background:var(--g);color:#000;font-weight:700;font-size:14px}
.b:disabled{opacity:.5}
.d,.e{border:0;padding:6px 10px;border-radius:6px;font-size:12px;color:#fff;background:#7f1d1d}.e{background:#1e3a8a}
.r{padding:8px 0;border-bottom:1px solid var(--line);font-size:13px}.r span+span{display:block;margin-top:6px}
.o{border:1px solid var(--line);border-radius:10px;padding:10px;margin-bottom:8px;font-size:13px}
.o a{color:var(--g2)}.o small{color:#9a9a9a;display:block}
.st{display:flex;flex-wrap:wrap;font-size:13px}.st div{width:50%;padding:4px 0}.st b{color:var(--g2)}
#m{text-align:center;font-weight:700;font-size:13px;margin:6px 0;min-height:18px}
</style>
</head>
<body>
<div class="c" id="login">
<h2>دخول الأدمن ⚙️</h2>
<input id="em" type="email" placeholder="الإيميل" autocomplete="username">
<input id="pw" type="password" placeholder="كلمة المرور" autocomplete="current-password">
<button class="b" id="li">دخول</button>
<p id="lm" style="color:#f87171;font-size:13px;margin-top:8px"></p>
</div>

<div id="panel" hidden>
<div class="c"><div id="m"></div>
<h2>📊 إحصائيات</h2>
<div class="st"><div>الزيارات: <b id="sv">0</b></div><div>الطلبات: <b id="so">0</b></div><div>إجمالي المبيعات: <b id="sr">0</b> ج.م</div><div></div>
<div style="width:100%">الأكثر مشاهدة: <b id="tv">—</b></div><div style="width:100%">الأكثر في المفضلة: <b id="tf">—</b></div></div></div>

<div class="c"><h2>⚙️ إعدادات المتجر</h2>
<label>رقم واتساب (بصيغة دولية 20xxxxxxxxxx)</label><input id="sw" inputmode="numeric">
<label>عنوان البانر</label><input id="sbh"><label>نص البانر</label><input id="sbp">
<label><input type="checkbox" id="sa">تشغيل الإعلانات</label>
<button class="b" id="ss">حفظ الإعدادات</button></div>

<div class="c"><h2 id="ft">إضافة منتج</h2>
<label>اسم المنتج</label><input id="pn">
<label>القسم</label><select id="pc"><option>هوديز</option><option>تيشيرتات</option><option>بناطيل</option><option>جواكت</option><option>أطقم</option></select>
<label>السعر (جنيه)</label><input id="pp" type="number" inputmode="numeric">
<label>الكمية المتاحة</label><input id="pst" type="number" inputmode="numeric" value="0">
<label>المقاسات (مفصولة بفاصلة)</label><input id="psz" value="M,L,XL,XXL">
<label>الألوان (اختياري، مفصولة بفاصلة)</label><input id="pcl">
<label>الوصف</label><textarea id="pd" rows="2"></textarea>
<label>صورة المنتج (ارفع من الموبايل)</label><input id="pf" type="file" accept="image/*">
<label>أو رابط صورة</label><input id="pu" placeholder="https://...">
<label><input type="checkbox" id="pfe">منتج مميز</label>
<label><input type="checkbox" id="pac" checked>ظاهر للعملاء</label>
<button class="b" id="add">حفظ المنتج</button>
<button class="d" id="can" style="width:100%;margin-top:8px;padding:10px" hidden>إلغاء التعديل</button></div>

<div class="c"><h2>المنتجات</h2><div id="pl"></div></div>

<div class="c"><h2>📢 الإعلانات</h2>
<label>العنوان</label><input id="at"><label>الوصف</label><input id="ad">
<label>الرابط (https://...)</label><input id="au">
<label>المكان</label><select id="apl"><option value="top">أعلى الصفحة الرئيسية</option><option value="feed">بين المنتجات</option></select>
<button class="b" id="aadd">إضافة إعلان</button><div id="al" style="margin-top:10px"></div></div>

<div class="c"><h2>🧾 الطلبات</h2><div id="ol"></div></div>
<div class="c"><h2>⭐ التقييمات</h2><div id="rl"></div></div>
<div class="c"><button class="d" id="lo" style="width:100%;padding:11px">تسجيل خروج</button></div>
</div>

<script>
"use strict";
const CFG={url:"https://uuffnrhsayengxplcusd.supabase.co",key:"sb_publishable_IzGVjT1tflAILnnAvbUTHw_mP8yiCHV"};
if(!window.supabase){document.body.innerHTML='<p style="padding:30px;text-align:center;color:#f87171">تعذّر تحميل مكتبة Supabase. افتح الصفحة من Chrome وانت متصل بالإنترنت.</p>';throw new Error("no supabase")}
const sb=window.supabase.createClient(CFG.url,CFG.key);
const $=i=>document.getElementById(i);
const esc=s=>String(s==null?"":s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const ST={new:"جديد",confirmed:"مؤكد",shipped:"اتشحن",done:"اتسلم",cancelled:"ملغي"};
const list=s=>s.split(",").map(x=>x.trim()).filter(Boolean);
let PL=[],editing=null;
function msg(t,ok){const e=$("m");e.style.color=ok?"#4ade80":"#f87171";e.textContent=t}
function show(on){$("login").hidden=on;$("panel").hidden=!on;if(on)loadAll()}
function loadAll(){loadS();loadP();loadA();loadO();loadR()}
async function loadR(){const r=await sb.from("reviews").select("*, products(name)").order("id",{ascending:false}).limit(40);
$("rl").innerHTML=r.error?"تعذّر التحميل":(r.data||[]).map(x=>'<div class="r"><span>'+"★".repeat(x.rating)+' · '+esc(x.name||"زائر")+' · '+(x.products?esc(x.products.name):"المتجر")+(x.approved?"":" · مخفي")+(x.comment?'<br><small style="color:#9a9a9a">'+esc(x.comment)+'</small>':'')+'</span><span><button class="e" data-rv="'+x.id+'" data-v="'+(x.approved?0:1)+'">'+(x.approved?"إخفاء":"إظهار")+'</button> <button class="d" data-rd="'+x.id+'">حذف</button></span></div>').join("")||"لا يوجد تقييمات."}
async function gate(){const r=await sb.rpc("is_admin");if(r.data===true)show(true);else{await sb.auth.signOut();show(false);$("lm").textContent="الحساب ده مش أدمن"}}
document.addEventListener("click",async e=>{const d=e.target.dataset;
if(d.rv){const r=await sb.from("reviews").update({approved:d.v==="1"}).eq("id",d.rv);if(r.error)msg(r.error.message,0);else loadR()}
if(d.rd&&confirm("حذف التقييم؟")){const r=await sb.from("reviews").delete().eq("id",d.rd);if(r.error)msg(r.error.message,0);else loadR()}});
async function loadS(){const r=await sb.from("settings").select("*"),m={};(r.data||[]).forEach(x=>{m[x.key]=x.value});
$("sw").value=m.whatsapp||"";$("sa").checked=m.ads_enabled==="true";$("sbh").value=m.banner_title||"";$("sbp").value=m.banner_text||"";
const v=await sb.from("stats").select("*").eq("key","visits");$("sv").textContent=v.data&&v.data[0]?v.data[0].value:0}
$("ss").onclick=async()=>{const w=$("sw").value.trim().replace(/\D/g,"");
if(!/^20\d{10}$/.test(w))return msg("رقم واتساب لازم يبدأ بـ 20 (مثال 201204064215)",0);
const r=await sb.from("settings").upsert([{key:"whatsapp",value:w},{key:"ads_enabled",value:$("sa").checked?"true":"false"},{key:"banner_title",value:$("sbh").value.trim()},{key:"banner_text",value:$("sbp").value.trim()}]);
msg(r.error?"خطأ: "+r.error.message:"تم حفظ الإعدادات ✓",!r.error)};
async function loadP(){const r=await sb.from("products").select("*").order("id",{ascending:false});
if(r.error){$("pl").textContent="تعذّر التحميل: "+r.error.message;return}PL=r.data||[];
$("pl").innerHTML=PL.map(p=>'<div class="r"><span>'+esc(p.name)+' · '+esc(p.category_name)+' · '+Number(p.price)+' ج · مخزون '+Number(p.stock)+(p.active?"":" · مخفي")+'</span><span><button class="e" data-e="'+p.id+'">تعديل</button> <button class="d" data-d="'+p.id+'">حذف</button></span></div>').join("")||"لا يوجد منتجات.";
const t=k=>PL.slice().sort((a,b)=>b[k]-a[k]).filter(p=>p[k]>0).slice(0,3).map(p=>esc(p.name)+" ("+p[k]+")").join("، ")||"—";
$("tv").innerHTML=t("views");$("tf").innerHTML=t("favs")}
function reset(){editing=null;["pn","pp","pd","pu","pcl"].forEach(i=>{$(i).value=""});$("pst").value="0";$("psz").value="M,L,XL,XXL";$("pf").value="";$("pfe").checked=false;$("pac").checked=true;$("ft").textContent="إضافة منتج";$("can").hidden=true}
$("can").onclick=reset;
$("add").onclick=async()=>{
const name=$("pn").value.trim(),price=Number($("pp").value);
if(!name||$("pp").value===""||!(price>=0))return msg("اكتب اسم المنتج والسعر",0);
let url=$("pu").value.trim();const f=$("pf").files[0];$("add").disabled=true;
if(f){const path=Date.now()+"-"+f.name.replace(/[^\w.-]/g,"_");const u=await sb.storage.from("products").upload(path,f);
if(u.error){$("add").disabled=false;return msg("فشل رفع الصورة: "+u.error.message,0)}
url=sb.storage.from("products").getPublicUrl(path).data.publicUrl}
const o={name:name,category_name:$("pc").value,price:price,stock:parseInt($("pst").value||"0",10)||0,sizes:list($("psz").value),colors:list($("pcl").value),description:$("pd").value.trim(),image_url:url,featured:$("pfe").checked,active:$("pac").checked};
if(!o.sizes.length)o.sizes=["M","L","XL","XXL"];
const r=editing?await sb.from("products").update(o).eq("id",editing):await sb.from("products").insert([o]);
$("add").disabled=false;
if(r.error)return msg("خطأ: "+r.error.message,0);
msg("تم الحفظ ✓",1);reset();loadP()};
async function loadA(){const r=await sb.from("ads").select("*").order("id",{ascending:false});
$("al").innerHTML=r.error?"تعذّر التحميل":(r.data||[]).map(a=>'<div class="r"><span>'+esc(a.title)+' · '+(a.placement==="top"?"أعلى":"وسط")+' · ظهور '+a.impressions+' · نقرات '+a.clicks+(a.active?"":" · موقوف")+'</span><span><button class="e" data-at="'+a.id+'" data-v="'+(a.active?0:1)+'">'+(a.active?"إيقاف":"تشغيل")+'</button> <button class="d" data-ad="'+a.id+'">حذف</button></span></div>').join("")||"لا يوجد إعلانات."}
$("aadd").onclick=async()=>{const t=$("at").value.trim(),u=$("au").value.trim();
if(!t||!/^https:\/\//.test(u))return msg("اكتب عنوان ورابط يبدأ بـ https://",0);
const r=await sb.from("ads").insert([{title:t,description:$("ad").value.trim(),url:u,placement:$("apl").value,active:true}]);
if(r.error)return msg("خطأ: "+r.error.message,0);$("at").value=$("ad").value=$("au").value="";loadA()};
async function loadO(){const r=await sb.from("orders").select("*").order("created_at",{ascending:false}).limit(50);
if(r.error){$("ol").textContent="تعذّر التحميل";return}const D=r.data||[];
let rev=0;D.forEach(o=>{if(o.status!=="cancelled")rev+=Number(o.total)||0});$("so").textContent=D.length;$("sr").textContent=rev;
$("ol").innerHTML=D.map(o=>{const it=(o.items||[]).map(i=>esc(i.name)+" ("+esc(i.size)+(i.color?"/"+esc(i.color):"")+")×"+Number(i.qty)).join("، ");
return '<div class="o"><b>'+esc(o.name)+'</b> · <a href="tel:'+esc(o.phone)+'">'+esc(o.phone)+'</a> · <a target="_blank" rel="noopener" href="https://wa.me/2'+esc(o.phone)+'">واتساب</a><small>'+esc(o.address)+'</small><small>'+it+'</small><small>'+esc(o.payment_method)+' · '+Number(o.total)+' ج.م</small><select data-s="'+o.id+'" style="margin:8px 0 0">'+Object.keys(ST).map(k=>'<option value="'+k+'"'+(o.status===k?" selected":"")+'>'+ST[k]+'</option>').join("")+'</select></div>'}).join("")||"لا يوجد طلبات."}
$("li").onclick=async()=>{$("lm").textContent="";const r=await sb.auth.signInWithPassword({email:$("em").value.trim(),password:$("pw").value});
if(r.error)$("lm").textContent="الدخول فشل: "+r.error.message;else{$("pw").value="";gate()}};
$("lo").onclick=async()=>{await sb.auth.signOut();show(false)};
document.addEventListener("click",async e=>{const d=e.target.dataset;
if(d.e){const p=PL.find(x=>x.id==d.e);if(!p)return;editing=p.id;$("pn").value=p.name;$("pc").value=p.category_name;$("pp").value=p.price;$("pst").value=p.stock;$("psz").value=(p.sizes||[]).join(",");$("pcl").value=(p.colors||[]).join(",");$("pd").value=p.description||"";$("pu").value=p.image_url||"";$("pfe").checked=!!p.featured;$("pac").checked=!!p.active;$("ft").textContent="تعديل منتج";$("can").hidden=false;scrollTo(0,0)}
if(d.d&&confirm("حذف المنتج؟")){const r=await sb.from("products").delete().eq("id",d.d);if(r.error)msg(r.error.message,0);else loadP()}
if(d.at){const r=await sb.from("ads").update({active:d.v==="1"}).eq("id",d.at);if(r.error)msg(r.error.message,0);else loadA()}
if(d.ad&&confirm("حذف الإعلان؟")){const r=await sb.from("ads").delete().eq("id",d.ad);if(r.error)msg(r.error.message,0);else loadA()}});
document.addEventListener("change",async e=>{const s=e.target.dataset.s;
if(s){const r=await sb.from("orders").update({status:e.target.value}).eq("id",s);if(r.error)msg(r.error.message,0);else loadO()}});
sb.auth.getSession().then(r=>{if(r.data&&r.data.session)gate();else show(false)});
if("serviceWorker" in navigator)navigator.serviceWorker.register("sw.js").catch(()=>{});
</script>
</body>
</html>
